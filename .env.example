# Application mode and local durable-storage roots. Use paths outside the Git worktree.
COCOA_ENV=development
COCOA_HOST=127.0.0.1
COCOA_PORT=8000
COCOA_CORS_ALLOWED_ORIGINS=http://localhost:5173
COCOA_DATA_ROOT=./.local/data
COCOA_MODEL_ROOT=./.local/models
COCOA_ARTIFACT_ROOT=./.local/artifacts

# Runtime selection defaults. GPU use must be requested explicitly and verified at runtime.
COCOA_DEFAULT_MODEL_FORMAT=pth
COCOA_DEFAULT_DEVICE=cpu
COCOA_LOG_LEVEL=INFO

# Single local administrator. Generate the hash without committing the password:
# python -c "from cocoa_platform.auth.service import hash_password; print(hash_password('your-password'))"
COCOA_ADMIN_EMAIL=admin@chula.ac.th
COCOA_ADMIN_PASSWORD_HASH=
COCOA_AUTH_SECRET=
COCOA_MODEL_REGISTRY=./backend/config/model_registry.json

# Supabase is optional during local-first development. Never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_RESULTS=cocoa-analysis-artifacts
SUPABASE_STORAGE_BUCKET_BENCHMARKS=cocoa-benchmark-artifacts
